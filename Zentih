                        currentValue = opt
                        Box.Text = opt
                        closeList()
                        callback(opt)
                    end)
                    rows[#rows + 1] = OptBtn
                end
            end
            return math.min(count * 30, 150)
        end
        rebuildList("")

        Box.Focused:Connect(function()
            closeAllPanelsExcept(closeList)
            local h = rebuildList(Box.Text == default and "" or Box.Text)
            tween(List, { Size = UDim2.fromOffset(140, h) }, 0.12)
        end)
        Box:GetPropertyChangedSignal("Text"):Connect(function()
            local h = rebuildList(Box.Text)
            tween(List, { Size = UDim2.fromOffset(140, h) }, 0.12)
        end)
        Box.FocusLost:Connect(function()
            task.wait(0.15) -- allow option click to register first
            closeList()
        end)

        registerFlag(config.Flag,
            function() return currentValue end,
            function(v) currentValue = v; Box.Text = v; callback(v) end)

        return { Set = function(_, v) currentValue = v; Box.Text = v; callback(v) end }
    end

