--// Config System ----------------------------------------------------
function Solar:SaveConfig(name)
    name = name or "default"
    local data = {}
    for flag, getValue in pairs(self._flagSetters) do
        data[flag] = getValue.get()
    end
    local ok = safeWritefile(self.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
    self:Notify({
        Title = ok and "บันทึกแล้ว" or "ล้มเหลว",
        Content = ok and ("บันทึกตั้งค่าลงไฟล์ \"" .. name .. "\" เรียบร้อย") or "Executor ไม่รองรับ writefile",
        Duration = 3,
    })
    return ok
end

function Solar:LoadConfig(name)
    name = name or "default"
    local raw = safeReadfile(self.ConfigFolder .. "/" .. name .. ".json")
    if not raw then
        self:Notify({ Title = "โหลดล้มเหลว", Content = "ไม่พบไฟล์ชื่อ \"" .. name .. "\"", Duration = 3 })
        return false
    end
    local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if not ok then
        self:Notify({ Title = "โหลดล้มเหลว", Content = "ไฟล์ตั้งค่าเสียหาย", Duration = 3 })
        return false
    end
    for flag, value in pairs(data) do
        local setter = self._flagSetters[flag]
        if setter then setter.set(value) end
    end
    self:Notify({ Title = "โหลดสำเร็จ", Content = "โหลดตั้งค่าจาก \"" .. name .. "\" แล้ว", Duration = 3 })
    return true
end

function Solar:Destroy()
    if self.ScreenGui then self.ScreenGui:Destroy() end
end

--// Tabs -------------------------------------------------------------------
function Solar:CreateTab(config)
    config = config or {}
    local name = config.Name or "แท็บ"
    local icon = config.Icon or "•"

    self._tabOrder = self._tabOrder + 1
    local order = self._tabOrder

    local TabButton = create("TextButton", {
        Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 36), LayoutOrder = order, Parent = self.TabList,
    }, { corner(R.Control) })

    local AccentPill = create("Frame", {
        Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 2, 0.5, -8),
        BackgroundColor3 = Theme.Accent, BorderSizePixel = 0,
        BackgroundTransparency = 1, Parent = TabButton,
    }, { corner(2) })

    local IconLabel = create("TextLabel", {
        Text = icon, Font = Enum.Font.GothamMedium, TextSize = 13,
        TextColor3 = Theme.TextTab, BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 0), Size = UDim2.fromOffset(18, 36),
        Parent = TabButton,
    })
    local Label = create("TextLabel", {
        Text = name, Font = Enum.Font.GothamMedium, TextSize = 13,
        TextColor3 = Theme.TextTab, TextXAlignment = Enum.TextXAlignment.Left,
        BackgroundTransparency = 1, Position = UDim2.fromOffset(36, 0),
        Size = UDim2.new(1, -40, 1, 0), Parent = TabButton,
    })

    local Page = create("ScrollingFrame", {
        Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BorderSizePixel = 0,
        ScrollBarThickness = 3, ScrollBarImageColor3 = Theme.Stroke,
        CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
        Visible = false, Parent = self.Content,
    })
    create("UIPadding", {
        PaddingTop = UDim.new(0, 16), PaddingLeft = UDim.new(0, 18),
        PaddingRight = UDim.new(0, 18), PaddingBottom = UDim.new(0, 16),
    }).Parent = Page
    create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }).Parent = Page

    local Tab = { Page = Page, _order = 0, Window = self, Name = name, Button = TabButton }

    local function setActive(active)
        tween(AccentPill, { BackgroundTransparency = active and 0 or 1 })
        tween(TabButton, { BackgroundColor3 = active and Theme.Card or Theme.Sidebar })
        tween(Label, { TextColor3 = active and Theme.TextTabActive or Theme.TextTab })
        tween(IconLabel, { TextColor3 = active and Theme.Accent or Theme.TextTab })
        Label.Font = active and Enum.Font.GothamBold or Enum.Font.GothamMedium
        Page.Visible = active
    end

    TabButton.MouseEnter:Connect(function()
        if not Page.Visible then tween(TabButton, { BackgroundColor3 = Theme.CardHover }) end
    end)
    TabButton.MouseLeave:Connect(function()
        if not Page.Visible then tween(TabButton, { BackgroundColor3 = Theme.Sidebar }) end
    end)

    TabButton.MouseButton1Click:Connect(function()
        for _, t in pairs(self.Tabs) do t.setActive(false) end
        setActive(true)
    end)

    Tab.setActive = setActive
    self.Tabs[#self.Tabs + 1] = Tab
    if #self.Tabs == 1 then setActive(true) end

    -- Card Primitive
    local function baseCard(order, height)
        return create("Frame", {
            BackgroundColor3 = Theme.Card, Size = UDim2.new(1, 0, 0, height or 52),
            LayoutOrder = order, Parent = Page,
        }, { corner(R.Card), stroke(Theme.Stroke, 1) })
    end

    local function cardTexts(Card, title, desc, rightPad)
        create("TextLabel", {
            Text = title, Font = Enum.Font.GothamMedium, TextSize = 13,
            TextColor3 = Theme.TextPrimary, TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(14, desc ~= "" and 8 or 0),
            Size = UDim2.new(1, -(rightPad + 14), 0, desc ~= "" and 18 or 52),
            Parent = Card,
        })
        if desc and desc ~= "" then
            create("TextLabel", {
                Text = desc, Font = Enum.Font.Gotham, TextSize = 11,
                TextColor3 = Theme.TextSecondary, TextXAlignment = Enum.TextXAlignment.Left,
                BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 26),
                Size = UDim2.new(1, -(rightPad + 14), 0, 16), Parent = Card,
            })
        end
    end

    local function registerFlag(flag, getFn, setFn)
        if not flag then return end
        self._flagSetters[flag] = { get = getFn, set = setFn }
    end

    --// Section ----------------------------------------------------------
    function Tab:CreateSection(name)
        self._order = self._order + 1
        create("TextLabel", {
            Text = name, Font = Enum.Font.GothamBold, TextSize = 16,
            TextColor3 = Theme.TextPrimary, TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24),
            LayoutOrder = self._order, Parent = Page,
        })
    end

    --// Label -------------------------------------------------------
    function Tab:CreateLabel(text)
        self._order = self._order + 1
        create("TextLabel", {
            Text = text, Font = Enum.Font.Gotham, TextSize = 12,
            TextColor3 = Theme.TextSecondary, TextXAlignment = Enum.TextXAlignment.Left,
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
            LayoutOrder = self._order, Parent = Page,
        })
    end

    --// Divider -------------------------------------------------------
    function Tab:CreateDivider()
        self._order = self._order + 1
        create("Frame", {
            Size = UDim2.new(1, 0, 0, 1),
            BackgroundColor3 = Theme.Stroke, BorderSizePixel = 0,
            LayoutOrder = self._order, Parent = Page,
        })
    end

    --// Paragraph -------------------------------------------------------
    function Tab:CreateParagraph(config)
        config = config or {}
        local title, content = config.Title or "", config.Content or ""
        self._order = self._order + 1
        local Holder = create("Frame", {
            Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1, LayoutOrder = self._order, Parent = Page,
        })
        local y = 0
        if title ~= "" then
            create("TextLabel", {
                Text = title, Font = Enum.Font.GothamBold, TextSize = 13,
                TextColor3 = Theme.TextPrimary, TextXAlignment = Enum.TextXAlignment.Left,
