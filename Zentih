    --// Combo Box (Search + Dropdown) -----------------------------------
    function Tab:CreateComboBox(config)
        config = config or {}
        local title = config.Title or "Combo Box"
        local options = config.Options or {}
        local default = config.Default or options[1] or ""
        local callback = config.Callback or function() end

        self._order = self._order + 1
        local Card = baseCard(self._order, 52)
        cardTexts(Card, title, "", 160)

        local Box = create("TextBox", {
            Text = default, PlaceholderText = "ค้นหา...",
            Font = Enum.Font.Gotham, TextSize = 12,
            TextColor3 = Theme.TextPrimary, PlaceholderColor3 = Theme.TextSecondary,
            BackgroundColor3 = Theme.ToggleOff, ClearTextOnFocus = false,
            Size = UDim2.fromOffset(140, 30), Position = UDim2.new(1, -154, 0.5, -15),
            Parent = Card,
        }, { corner(R.Control), stroke(Theme.Stroke, 1) })
        create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 20) }).Parent = Box

        local List = create("ScrollingFrame", {
            Size = UDim2.fromOffset(140, 0), Position = UDim2.new(1, -154, 1, 4),
            BackgroundColor3 = Theme.Card, ClipsDescendants = true, ZIndex = 10,
            ScrollBarThickness = 2, CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y, Visible = false,
            Parent = Card,
        }, { corner(R.Control), stroke(Theme.Stroke, 1) })
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }).Parent = List

        local currentValue = default
        local rows = {}

        local function rebuildList(filter)
            for _, r in ipairs(rows) do r:Destroy() end
            rows = {}
            local count = 0
            for i, opt in ipairs(options) do
                if filter == "" or opt:lower():find(filter:lower(), 1, true) then
                    count = count + 1
                    local OptBtn = create("TextButton", {
                        Text = opt, Font = Enum.Font.Gotham, TextSize = 11,
                        TextColor3 = Theme.TextPrimary, AutoButtonColor = false,
                        BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 26),
                        LayoutOrder = i, ZIndex = 11, Parent = List,
                    })
                    OptBtn.MouseButton1Click:Connect(function()
                        currentValue = opt
                        Box.Text = opt
                        List.Visible = false
                        tween(List, { Size = UDim2.fromOffset(140, 0) })
                        callback(opt)
                    end)
                    rows[#rows + 1] = OptBtn
                end
            end
            return math.min(count * 26, 110)
        end
        rebuildList("")

        Box.Focused:Connect(function()
            List.Visible = true
            local h = rebuildList(Box.Text == default and "" or Box.Text)
            tween(List, { Size = UDim2.fromOffset(140, h) })
        end)
        Box:GetPropertyChangedSignal("Text"):Connect(function()
            if Box:IsFocused() then
                List.Visible = true
                local h = rebuildList(Box.Text)
                tween(List, { Size = UDim2.fromOffset(140, h) })
            end
        end)
        Box.FocusLost:Connect(function()
            task.wait(0.12)
            List.Visible = false
            tween(List, { Size = UDim2.fromOffset(140, 0) })
        end)

        registerFlag(config.Flag,
            function() return currentValue end,
            function(v) currentValue = v; Box.Text = v; callback(v) end)

        return { Set = function(_, v) currentValue = v; Box.Text = v; callback(v) end }
    end

