            BackgroundColor3 = Theme.CardHover, ClipsDescendants = true, ZIndex = 20,
            Parent = Card,
        }, { corner(R.Control), stroke(Theme.Stroke, 1) })
        local ListLayout = create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder })
